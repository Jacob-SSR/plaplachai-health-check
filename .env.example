APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ppc_health_check
DB_USER=health_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
ADMIN_USERNAME=admin
# Used by npm run db:bootstrap only. Remove ADMIN_PASSWORD afterwards.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encryption key for stored recipient IDs. Generate once and back up securely.
DATA_ENCRYPTION_KEY=
# Run the generator again for a DIFFERENT key: used for CID HMAC fingerprints.
# These are application keys you generate locally, not keys issued by MOPH.
CID_HMAC_KEY=
# Copy Client_ID and Secret from MOPH CMS > API Key into the two fields below.
# Free Form 3.1 uses this pair; no separate Bearer token is needed by default.
# Live sends also require LIVE enabled in the admin page and a running worker.
MOPH_LIVE_ENABLED=false
MOPH_CLIENT_KEY=
MOPH_SECRET_KEY=
# Leave empty for the supplied Free Form collection (noauth).
# Set only if your provider explicitly requires additional Bearer authentication.
MOPH_BEARER_TOKEN=
