APP_ORIGIN=http://localhost:5600
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ppc_health_check
DB_USER=health_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
ADMIN_USERNAME=admin
# Used by npm run db:bootstrap only. Remove ADMIN_PASSWORD afterwards.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encryption key for stored recipient IDs. Generate once and back up securely.
DATA_ENCRYPTION_KEY=
# Run the generator again for a DIFFERENT key: used for CID HMAC fingerprints.
# These are application keys you generate locally, not keys issued by MOPH.
CID_HMAC_KEY=
# Copy Client_ID and Secret from MOPH CMS > API Key into the two fields below.
# Free Form 3.1 uses this pair; no separate Bearer token is needed by default.
# Live sends also require LIVE enabled in the admin page and a running worker.
MOPH_LIVE_ENABLED=false
MOPH_CLIENT_KEY=
MOPH_SECRET_KEY=
# Leave empty for the supplied Free Form collection (noauth).
# Set only if your provider explicitly requires additional Bearer authentication.
MOPH_BEARER_TOKEN=
# HOSxP source connection. Use a SELECT-only account for oapp, patient, doctor and kskdepartment.
# Separate from DB_* (the application's own database). Never use migration credentials here.
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=
HOSXP_DB_USER=
HOSXP_DB_PASSWORD=
# Match the source database character set (commonly tis620; use utf8mb4 if applicable).
HOSXP_DB_CHARSET=tis620
# Comma-separated active oapp_status_id values from your HOSxP installation.
# NULL and 1 are normal appointments. Other/unknown statuses are hidden and never send.
HOSXP_ACTIVE_STATUS_IDS=NULL,1

# Notice style: flex (own LINE card with hospital logo, falls back to MOPH template if rejected),
# template (MOPH Alert Template 3.1 card, logo from MOPH CMS) or freeform (plain text).
MOPH_API_MODE=flex
MOPH_TEMPLATE_NAME=ยินดีต้อนรับ
# Public HTTPS URL of the logo shown in the flex card. Defaults to APP_ORIGIN/hospital-logo.png when APP_ORIGIN is https.
PUBLIC_LOGO_URL=
