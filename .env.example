APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ppc_health_check
DB_USER=health_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
ADMIN_USERNAME=admin
# Used by npm run db:bootstrap only. Remove ADMIN_PASSWORD afterwards.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
CID_HMAC_KEY=
# Live sends require BOTH the database setting and this server switch.
MOPH_LIVE_ENABLED=false
MOPH_CLIENT_KEY=
MOPH_SECRET_KEY=
# Optional only if the provider explicitly confirms Bearer is required.
MOPH_BEARER_TOKEN=
